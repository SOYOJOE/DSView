@@ -0,0 +1,494 @@
+/*
+ * usb_gpio_event.c - EVENT protocol v3 encoder + USB CDC TX backend.
+ *
+ * Wire protocol: [uint24_le delta_ticks][1B header][payload...]
+ * Clock:         24 MHz systimer ticks
+ */
+#include "usb_gpio_event.h"
+
+#if (USB_DEMO_TYPE == USB_CDC)
+
+#include "application/usb_app/usbcdc.h"
+#include "application/usbstd/usb.h"
+#include <string.h>
+
+#define USB_GPIO_EVENT_TX_SIZE USB_GPIO_EVENT_TX_CAPACITY
+#define USB_GPIO_EVENT_TX_MASK (USB_GPIO_EVENT_TX_SIZE - 1u)
+
+#if (USB_GPIO_EVENT_TX_SIZE & USB_GPIO_EVENT_TX_MASK)
+    #error "USB_GPIO_EVENT_TX_SIZE must be a power of 2."
+#endif
+
+#define GPIO_LOW    0x00
+#define GPIO_HIGH   0x20
+#define GPIO_TOGGLE 0x40
+#define HEADER_SYNC       0xA0
+#define HEADER_TEXT_HEX   0xC0
+#define HEADER_TEXT_ASCII 0xE0
+#define GPIO_STATE_MASK   0x0fffffffu
+#define GPIO_EVENT_MAX_FRAME_SIZE 264
+#define SYNC_MAGIC0 0x55
+#define SYNC_MAGIC1 0xAA
+#define SYNC_MAGIC2 0x5A
+#define SYNC_MAGIC3 0xA5
+
+#define USB_DBG_LED0 LED1
+#define USB_GPIO_EVENT_SEND_SHORT_PACKET 0
+
+static unsigned char tx_buf[USB_GPIO_EVENT_TX_SIZE] __attribute__((aligned(4)));
+static volatile unsigned int tx_head;
+static volatile unsigned int tx_tail;
+static volatile int          tx_buffer_lock;
+static volatile unsigned int tx_drop_bytes;
+static volatile unsigned char tx_enabled;
+static volatile unsigned char tx_in_flight;
+
+static uint32_t g_gpio_state;
+static uint32_t g_last_tick;
+static int      g_initialized;
+
+static inline unsigned int tx_used_snapshot(void)
+{
+    return tx_head - tx_tail;
+}
+
+static inline unsigned int tx_free_snapshot(void)
+{
+    return USB_GPIO_EVENT_TX_SIZE - tx_used_snapshot();
+}
+
+static inline void tx_write_at(unsigned int head, unsigned int offset, unsigned char byte)
+{
+    tx_buf[(head + offset) & USB_GPIO_EVENT_TX_MASK] = byte;
+}
+
+static inline void tx_drop(unsigned int n)
+{
+    tx_drop_bytes += n;
+}
+
+static inline int tx_reserve(unsigned int n)
+{
+    if (n > USB_GPIO_EVENT_TX_SIZE) {
+        tx_drop(n);
+        return 0;
+    }
+    if (tx_free_snapshot() < n) {
+        tx_drop(n);
+        return 0;
+    }
+    return 1;
+}
+
+static inline void usb_tx_write_frame4(uint32_t dword)
+{
+    unsigned int head;
+
+    if (!tx_reserve(4)) {
+        return;
+    }
+
+    head = tx_head;
+    tx_write_at(head, 0, (unsigned char)dword);
+    tx_write_at(head, 1, (unsigned char)(dword >> 8));
+    tx_write_at(head, 2, (unsigned char)(dword >> 16));
+    tx_write_at(head, 3, (unsigned char)(dword >> 24));
+    tx_head = head + 4;
+}
+
+static inline void __attribute__((always_inline))
+usb_tx_write_frame4_irq(uint32_t dword)
+{
+    unsigned int head;
+
+    if (tx_buffer_lock || tx_free_snapshot() < 4) {
+        tx_drop(4);
+        return;
+    }
+
+    head = tx_head;
+    tx_write_at(head, 0, (unsigned char)dword);
+    tx_write_at(head, 1, (unsigned char)(dword >> 8));
+    tx_write_at(head, 2, (unsigned char)(dword >> 16));
+    tx_write_at(head, 3, (unsigned char)(dword >> 24));
+    tx_head = head + 4;
+}
+
+static void usb_tx_write_block(const unsigned char *data, unsigned int len)
+{
+    unsigned int head;
+    unsigned int offset;
+
+    if (!tx_reserve(len)) {
+        return;
+    }
+
+    head = tx_head;
+    for (offset = 0; offset < len; offset++) {
+        tx_write_at(head, offset, data[offset]);
+    }
+    tx_head = head + len;
+}
+
+void usb_gpio_event_set_enabled(unsigned char enabled)
+{
+    tx_enabled = enabled;
+}
+
+void usb_gpio_event_reset_tx(void)
+{
+    unsigned int r;
+
+    r = core_interrupt_disable();
+    tx_buffer_lock = 1;
+    tx_head        = 0;
+    tx_tail        = 0;
+    tx_drop_bytes  = 0;
+    tx_in_flight   = 0;
+    tx_buffer_lock = 0;
+    core_restore_interrupt(r);
+}
+
+unsigned int usb_gpio_event_tx_available(void)
+{
+    return tx_used_snapshot();
+}
+
+void usb_gpio_event_tx_complete(void)
+{
+    tx_in_flight = 0;
+}
+
+unsigned char usb_gpio_event_tx_try_queue_packet(void)
+{
+    unsigned int r;
+    unsigned int len;
+
+    r = core_interrupt_disable();
+
+    if (!tx_enabled || tx_in_flight || usbhw_is_ep_busy(USB_PHYSICAL_EDP_CDC_IN)) {
+        core_restore_interrupt(r);
+        return 0;
+    }
+
+    len = tx_used_snapshot();
+    if (len == 0) {
+        core_restore_interrupt(r);
+        return 0;
+    }
+#if (!USB_GPIO_EVENT_SEND_SHORT_PACKET)
+    if (len < CDC_TXRX_EPSIZE) {
+        core_restore_interrupt(r);
+        return 0;
+    }
+#endif
+    if (len > CDC_TXRX_EPSIZE) {
+        len = CDC_TXRX_EPSIZE;
+    }
+
+    gpio_set_high_level(USB_DBG_LED0);
+    usbhw_reset_ep_ptr(USB_PHYSICAL_EDP_CDC_IN);
+    for (unsigned int i = 0; i < len; i++) {
+        reg_usb_ep_dat(USB_PHYSICAL_EDP_CDC_IN) = tx_buf[tx_tail & USB_GPIO_EVENT_TX_MASK];
+        tx_tail++;
+    }
+    usbhw_data_ep_ack(USB_PHYSICAL_EDP_CDC_IN);
+    tx_in_flight = 1;
+    gpio_set_low_level(USB_DBG_LED0);
+    core_restore_interrupt(r);
+
+    return 1;
+}
+
+void uart_tx_poll(void)
+{
+    gpio_event_tx();
+}
+
+void user_uart_send_byte(uint8_t byte)
+{
+    usb_tx_write_block(&byte, 1);
+}
+
+void user_uart_flush(void)
+{
+    while (tx_used_snapshot() != 0) {
+        if (!tx_enabled) {
+            break;
+        }
+        gpio_event_tx();
+    }
+}
+
+static inline void __attribute__((always_inline))
+gpio_event_emit(uint32_t new_state, uint8_t sub_mode, int channel)
+{
+    uint32_t now;
+    uint32_t delta;
+    uint32_t dword;
+
+    if (!g_initialized) {
+        return;
+    }
+
+    now          = stimer_get_tick();
+    delta        = now - g_last_tick;
+    g_last_tick  = now;
+    g_gpio_state = new_state;
+
+    dword = (delta & 0x00ffffffu) | ((uint32_t)(sub_mode | (uint8_t)channel) << 24);
+    usb_tx_write_frame4(dword);
+}
+
+void gpio_event_high(int channel)
+{
+    if ((uint32_t)channel > GPIO_EVENT_GPIO_MAX) {
+        return;
+    }
+    gpio_event_emit(g_gpio_state | (1u << (uint32_t)channel), GPIO_HIGH, channel);
+}
+
+void gpio_event_low(int channel)
+{
+    if ((uint32_t)channel > GPIO_EVENT_GPIO_MAX) {
+        return;
+    }
+    gpio_event_emit(g_gpio_state & ~(1u << (uint32_t)channel), GPIO_LOW, channel);
+}
+
+void gpio_event_toggle(int channel)
+{
+    uint32_t mask;
+
+    if ((uint32_t)channel > GPIO_EVENT_GPIO_MAX) {
+        return;
+    }
+
+    mask = 1u << (uint32_t)channel;
+    if (g_gpio_state & mask) {
+        gpio_event_emit(g_gpio_state & ~mask, GPIO_LOW, channel);
+    } else {
+        gpio_event_emit(g_gpio_state | mask, GPIO_HIGH, channel);
+    }
+}
+
+void gpio_event_toggle_mask(uint32_t mask)
+{
+    unsigned int head;
+    unsigned int offset = 0;
+    uint32_t now;
+    uint32_t delta;
+    uint32_t new_state;
+
+    mask &= GPIO_STATE_MASK;
+    if (!g_initialized || mask == 0) {
+        return;
+    }
+
+    if (!tx_reserve((GPIO_EVENT_GPIO_MAX + 1u) * 4u)) {
+        return;
+    }
+
+    now         = stimer_get_tick();
+    delta       = now - g_last_tick;
+    g_last_tick = now;
+    new_state   = g_gpio_state ^ mask;
+    g_gpio_state = new_state;
+
+    head = tx_head;
+    for (unsigned int channel = 0; channel <= GPIO_EVENT_GPIO_MAX; channel++) {
+        uint32_t channel_mask = 1u << channel;
+        uint8_t sub_mode;
+        uint32_t dword;
+
+        if ((mask & channel_mask) == 0) {
+            continue;
+        }
+
+        sub_mode = (new_state & channel_mask) ? GPIO_HIGH : GPIO_LOW;
+        dword    = (delta & 0x00ffffffu) | ((uint32_t)(sub_mode | (uint8_t)channel) << 24);
+        tx_write_at(head, offset++, (unsigned char)dword);
+        tx_write_at(head, offset++, (unsigned char)(dword >> 8));
+        tx_write_at(head, offset++, (unsigned char)(dword >> 16));
+        tx_write_at(head, offset++, (unsigned char)(dword >> 24));
+        delta = 0;
+    }
+    tx_head = head + offset;
+}
+
+static inline void __attribute__((always_inline))
+gpio_event_emit_irq(uint32_t new_state, uint8_t sub_mode, unsigned int channel)
+{
+    uint32_t now;
+    uint32_t dword;
+
+    now = stimer_get_tick();
+    dword = ((now - g_last_tick) & 0x00ffffffu) |
+            ((uint32_t)(sub_mode | (uint8_t)channel) << 24);
+
+    g_last_tick  = now;
+    g_gpio_state = new_state;
+    usb_tx_write_frame4_irq(dword);
+}
+
+_attribute_ram_code_sec_ void gpio_event_irq_high(unsigned int channel)
+{
+    gpio_event_emit_irq(g_gpio_state | (1u << channel), GPIO_HIGH, channel);
+}
+
+_attribute_ram_code_sec_ void gpio_event_irq_low(unsigned int channel)
+{
+    gpio_event_emit_irq(g_gpio_state & ~(1u << channel), GPIO_LOW, channel);
+}
+
+_attribute_ram_code_sec_ void gpio_event_irq_toggle(unsigned int channel)
+{
+    uint32_t mask = 1u << channel;
+
+    if (g_gpio_state & mask) {
+        gpio_event_emit_irq(g_gpio_state & ~mask, GPIO_LOW, channel);
+    } else {
+        gpio_event_emit_irq(g_gpio_state | mask, GPIO_HIGH, channel);
+    }
+}
+
+void gpio_event_init(void)
+{
+    usb_gpio_event_reset_tx();
+    tx_enabled    = 0;
+    g_gpio_state  = 0;
+    g_last_tick   = stimer_get_tick();
+    g_initialized = 1;
+}
+
+void gpio_event_reset_timer(void)
+{
+    if (!g_initialized) {
+        return;
+    }
+    g_last_tick = stimer_get_tick();
+}
+
+void gpio_event_send_sync(void)
+{
+    unsigned int head;
+    uint32_t now;
+    uint32_t delta;
+    uint32_t dword;
+    uint32_t state;
+    uint32_t inv_state;
+
+    if (!g_initialized || !tx_reserve(16)) {
+        return;
+    }
+
+    now         = stimer_get_tick();
+    delta       = now - g_last_tick;
+    g_last_tick = now;
+
+    state     = g_gpio_state & GPIO_STATE_MASK;
+    inv_state = ~state;
+    dword     = (delta & 0x00ffffffu) | ((uint32_t)HEADER_SYNC << 24);
+
+    head = tx_head;
+    tx_write_at(head, 0, (unsigned char)dword);
+    tx_write_at(head, 1, (unsigned char)(dword >> 8));
+    tx_write_at(head, 2, (unsigned char)(dword >> 16));
+    tx_write_at(head, 3, (unsigned char)(dword >> 24));
+    tx_write_at(head, 4, (unsigned char)state);
+    tx_write_at(head, 5, (unsigned char)(state >> 8));
+    tx_write_at(head, 6, (unsigned char)(state >> 16));
+    tx_write_at(head, 7, (unsigned char)(state >> 24));
+    tx_write_at(head, 8, (unsigned char)inv_state);
+    tx_write_at(head, 9, (unsigned char)(inv_state >> 8));
+    tx_write_at(head, 10, (unsigned char)(inv_state >> 16));
+    tx_write_at(head, 11, (unsigned char)(inv_state >> 24));
+    tx_write_at(head, 12, SYNC_MAGIC0);
+    tx_write_at(head, 13, SYNC_MAGIC1);
+    tx_write_at(head, 14, SYNC_MAGIC2);
+    tx_write_at(head, 15, SYNC_MAGIC3);
+    tx_head = head + 16;
+}
+
+void gpio_event_send_text(gpio_event_level_t level,
+                          gpio_event_render_mode_t render_mode,
+                          const uint8_t *label,
+                          int label_len,
+                          const uint8_t *data,
+                          int data_len)
+{
+    unsigned int head;
+    unsigned int offset;
+    uint32_t now;
+    uint32_t delta;
+    uint32_t dword;
+    uint8_t  header;
+    int      payload_len;
+    int      block_len;
+
+    if (!g_initialized) {
+        return;
+    }
+    if (level < 0 || level > GPIO_EVENT_RENDER_MAX) {
+        return;
+    }
+    if (render_mode != GPIO_EVENT_RENDER_MODE_HEX &&
+        render_mode != GPIO_EVENT_RENDER_MODE_ASCII) {
+        return;
+    }
+    if (label_len < 0 || label_len > 255 || data_len < 0 || data_len > 255) {
+        return;
+    }
+    if ((label_len > 0 && label == 0) || (data_len > 0 && data == 0)) {
+        return;
+    }
+    if (label_len == 0 && data_len == 0) {
+        return;
+    }
+
+    payload_len = 3 + label_len + data_len;
+    block_len   = (payload_len + 3) & ~3;
+    if (4 + block_len > GPIO_EVENT_MAX_FRAME_SIZE || !tx_reserve((unsigned int)(4 + block_len))) {
+        return;
+    }
+
+    now         = stimer_get_tick();
+    delta       = now - g_last_tick;
+    g_last_tick = now;
+
+    header = (render_mode == GPIO_EVENT_RENDER_MODE_HEX) ? HEADER_TEXT_HEX : HEADER_TEXT_ASCII;
+    dword  = (delta & 0x00ffffffu) | ((uint32_t)header << 24);
+
+    head = tx_head;
+    tx_write_at(head, 0, (unsigned char)dword);
+    tx_write_at(head, 1, (unsigned char)(dword >> 8));
+    tx_write_at(head, 2, (unsigned char)(dword >> 16));
+    tx_write_at(head, 3, (unsigned char)(dword >> 24));
+    tx_write_at(head, 4, (uint8_t)level);
+    tx_write_at(head, 5, (uint8_t)label_len);
+    tx_write_at(head, 6, (uint8_t)data_len);
+    offset = 7;
+    if (label_len > 0) {
+        for (int i = 0; i < label_len; i++) {
+            tx_write_at(head, offset++, label[i]);
+        }
+    }
+    if (data_len > 0) {
+        for (int i = 0; i < data_len; i++) {
+            tx_write_at(head, offset++, data[i]);
+        }
+    }
+    while (offset < (unsigned int)(4 + block_len)) {
+        tx_write_at(head, offset++, 0);
+    }
+    tx_head = head + (unsigned int)(4 + block_len);
+}
+
+void gpio_event_tx(void)
+{
+    tx_buffer_lock = 1;
+    (void)usb_gpio_event_tx_try_queue_packet();
+    tx_buffer_lock = 0;
+}
+
+#endif
