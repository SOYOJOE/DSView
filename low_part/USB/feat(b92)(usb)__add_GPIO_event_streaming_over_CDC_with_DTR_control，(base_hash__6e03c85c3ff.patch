+/*
+ * usb_gpio_event.h - MCU-side EVENT protocol v3 encoder over USB CDC.
+ *
+ * The byte stream is compatible with the old UART_VCD EVENT protocol. USB CDC
+ * only replaces the physical transport; frame layout stays unchanged.
+ */
+
+#ifndef USB_GPIO_EVENT_H
+#define USB_GPIO_EVENT_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    GPIO_EVENT_LEVEL_DEBUG = 0,
+    GPIO_EVENT_LEVEL_INFO  = 1,
+    GPIO_EVENT_LEVEL_WARN  = 2,
+    GPIO_EVENT_LEVEL_ERROR = 3,
+} gpio_event_level_t;
+
+typedef enum {
+    GPIO_EVENT_RENDER_MODE_HEX   = 0,
+    GPIO_EVENT_RENDER_MODE_ASCII = 1,
+} gpio_event_render_mode_t;
+
+#define GPIO_EVENT_SYS_CLOCK_HZ 24000000
+#define GPIO_EVENT_GPIO_MAX     27
+#define GPIO_EVENT_RENDER_MAX   3
+#define GPIO_EVENT_MAX_CHANNELS 32
+#define GPIO_EVENT_UART_OFFSET  28
+#define GPIO_EVENT_UART_BAUD    1000000
+#define GPIO_EVENT_UART_NUM     0
+#define GPIO_EVENT_UART_MARKER  0x80
+#define USB_GPIO_EVENT_TX_CAPACITY 8192u
+
+#include "common.h"
+
+extern void user_init(void);
+extern void main_loop(void);
+
+void gpio_event_init(void);
+void gpio_event_reset_timer(void);
+void gpio_event_high(int channel);
+void gpio_event_low(int channel);
+void gpio_event_toggle(int channel);
+void gpio_event_toggle_mask(uint32_t mask);
+
+/*
+ * Interrupt fast path. Use channel 0..27 only. Keep one event producer context:
+ * while these APIs are active, do not call regular GPIO/string or user_uart_*
+ * APIs from another context. The main loop may keep calling gpio_event_tx().
+ */
+void gpio_event_irq_high(unsigned int channel);
+void gpio_event_irq_low(unsigned int channel);
+void gpio_event_irq_toggle(unsigned int channel);
+
+void gpio_event_send_sync(void);
+void gpio_event_send_text(gpio_event_level_t level,
+                          gpio_event_render_mode_t render_mode,
+                          const uint8_t *label,
+                          int label_len,
+                          const uint8_t *data,
+                          int data_len);
+void gpio_event_tx(void);
+
+void uart_tx_poll(void);
+void user_uart_send_byte(uint8_t byte);
+void user_uart_flush(void);
+
+unsigned int usb_gpio_event_tx_available(void);
+unsigned char usb_gpio_event_tx_try_queue_packet(void);
+void usb_gpio_event_tx_complete(void);
+void usb_gpio_event_set_enabled(unsigned char enabled);
+void usb_gpio_event_reset_tx(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* USB_GPIO_EVENT_H */
